# Registry
#registry=https://registry.npmmirror.com
registry=https://registry.npmjs.org

# 依赖管理
# auto-install-peers=false: peer 必须显式声明在 package.json
# strict-peer-dependencies=true: peer 缺失立即报错，避免静默丢依赖
auto-install-peers=false
strict-peer-dependencies=true

# packageImportMethod / nodeLinker / confirmModulesPurge 等已迁移到 pnpm-workspace.yaml
#（pnpm 11+ 除 registry/auth 外其他设置从 .npmrc 迁出）

# 存储配置
# store-dir=~/.pnpm-store

# 网络优化
network-concurrency=32
fetch-retries=3
fetch-timeout=60000

# 安全
strict-ssl=true

# 日志（loglevel 候选: silent | error | warn | info | debug | verbose）
# 日常 warn，调试时临时 pnpm install --loglevel=info
loglevel=info

# 工作区
link-workspace-packages=true
save-workspace-protocol=rolling
