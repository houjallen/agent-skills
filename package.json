{
  "name": "@easbot/agent-skills",
  "version": "0.3.27",
  "description": "EASBot Agent Skills — the EASBot agent-skills management repository.",
  "type": "module",
  "bin": {
    "easbot-agent-skills": "./dist/cli.mjs"
  },
  "scripts": {
    "build": "tsup --env.NODE_ENV production",
    "test": "vitest",
    "test:run": "vitest run",
    "test:clean": "tsx scripts/clean-test-fixtures.ts",
    "lint": "biome check .",
    "lint:fix": "biome check --write .",
    "lint:report": "biome check --reporter=summary .",
    "format": "biome format . && prettier --check --no-error-on-unmatched-pattern \"**/*.md\" \"**/*.mdx\"",
    "format:fix": "biome format --write . && prettier --write --no-error-on-unmatched-pattern \"**/*.md\" \"**/*.mdx\"",
    "prepare": "husky",
    "type-check": "tsc --noEmit",
    "version:pre-commit": "tsx scripts/pre-commit-version.ts",
    "version:patch": "tsx scripts/bump-version.ts patch",
    "version:minor": "tsx scripts/bump-version.ts minor",
    "publish:npm": "bash scripts/publish.sh",
    "publish:npm:win": "powershell -ExecutionPolicy Bypass -File scripts/publish.ps1",
    "publish:list": "tsx ./scripts/list-published-versions.ts",
    "docs:add": "npx tsx ./scripts/docs_add_frontmatter.ts",
    "docs:sync": "npx tsx ./scripts/docs_sync_automation.ts",
    "docs:validate": "npx tsx ./scripts/docs_sync_automation.ts --validate",
    "plugin:generate": "npx tsx ./scripts/generate-plugin.ts .claude-plugin",
    "well-known:generate": "npx tsx ./scripts/generate-well-known.ts --validate",
    "well-known:validate": "node ./docs/schemas/agent-skills/validate-v1.cjs"
  },
  "keywords": [
    "ai",
    "agent",
    "skills",
    "easbot"
  ],
  "author": "houjallen",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/houjallen/agent-skills.git"
  },
  "homepage": "https://github.com/houjallen/agent-skills",
  "bugs": {
    "url": "https://github.com/houjallen/agent-skills/issues"
  },
  "files": [
    "skills",
    "dist",
    "CHANGELOG.md",
    "AGENTS.md",
    "README.md",
    "README.en.md",
    "LICENSE"
  ],
  "dependencies": {
    "@easbot/skills": "^0.3.26",
    "@easbot/utils": "^0.3.26"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.5",
    "@types/js-yaml": "4.0.9",
    "@types/node": "^25.9.5",
    "ai": "^6.0.290",
    "dotenv": "^17.4.2",
    "esbuild": "0.28.2",
    "glob": "^13.0.6",
    "husky": "^9.1.7",
    "js-yaml": "^5.3.0",
    "jszip": "3.10.1",
    "lint-staged": "^17.3.0",
    "node-pty": "1.1.0",
    "prettier": "^3.9.9",
    "tsup": "^8.5.1",
    "tsx": "4.23.12",
    "typescript": "6.0.3",
    "vitest": "^4.1.6",
    "xdg-basedir": "5.1.0",
    "zod": "^4.4.3"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org"
  },
  "engines": {
    "node": ">=22.22.2",
    "pnpm": ">=10.0.0"
  },
  "workspaces": {
    "packages": [
      "skills/**/*"
    ]
  },
  "lint-staged": {
    "*.{ts,tsx,js,jsx,mjs,cjs}": [
      "biome check --write --no-errors-on-unmatched",
      "biome format --write --no-errors-on-unmatched"
    ],
    "*.{json,jsonc}": [
      "biome format --write --no-errors-on-unmatched"
    ],
    "*.{md,mdx}": [
      "prettier --write"
    ]
  }
}
