{
  "name": "@eas-skills/eas-agent-creation",
  "version": "0.3.28",
  "description": "Standalone CLI for EASBot skill lifecycle — create, evolve, assess, list, apply-plan and LLM-review AI skills via six zod-validated operations.",
  "type": "module",
  "bin": {
    "eas-agent-creation": "./dist/cli.mjs"
  },
  "scripts": {
    "build": "tsup --env.NODE_ENV production",
    "test": "vitest",
    "test:run": "vitest run",
    "type-check": "tsc --noEmit",
    "lint": "biome check .",
    "lint:fix": "biome check --write .",
    "lint:report": "biome check --reporter=summary .",
    "format": "biome format .",
    "format:fix": "biome format --write .",
    "prepare": "echo norun",
    "publish:npm": "bash scripts/publish.sh",
    "publish:npm:win": "powershell -ExecutionPolicy Bypass -File scripts/publish.ps1"
  },
  "keywords": [
    "ai",
    "agent",
    "easbot",
    "skill",
    "lifecycle",
    "cli",
    "create",
    "evolve",
    "review",
    "tool-wrapper",
    "generator",
    "reviewer",
    "inversion",
    "pipeline",
    "typescript",
    "zod"
  ],
  "author": "houjallen",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/houjallen/agent-skills.git",
    "directory": "skills/builtin/eas-agent-creation/scripts"
  },
  "homepage": "https://github.com/houjallen/agent-skills/tree/main/skills/builtin/eas-agent-creation/scripts#readme",
  "bugs": {
    "url": "https://github.com/houjallen/agent-skills/issues"
  },
  "files": [
    "dist",
    "README.md",
    "README.en.md",
    "LICENSE"
  ],
  "dependencies": {
    "@easbot/llm": "^0.3.27",
    "@easbot/plugin": "^0.3.27",
    "@easbot/utils": "^0.3.27",
    "xdg-basedir": "^5.1.0",
    "ai": "^6.0.290",
    "zod": "^4.4.3",
    "glob": "^13.0.6"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.5",
    "@easbot/terminal": "^0.3.27",
    "@types/js-yaml": "4.0.9",
    "@types/node": "^25.9.5",
    "typescript": "^6.0.3",
    "vitest": "^4.1.10",
    "tsup": "^8.5.1",
    "tsx": "4.23.12"
  },
  "engines": {
    "node": ">=22.22.2"
  },
  "publishConfig": {
    "access": "public"
  }
}
